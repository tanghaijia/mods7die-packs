{
  "schema_version": 1,
  "pack": "undead-legacy",
  "version": "2.7.32",
  "game_version": { "min": "2.6", "max": "2.6" },

  // ---------------------------------------------------------------------------
  // 这条条目的首要作用是：让应用把"装的是哪个版本"**记对**。
  //
  // 为什么不能省：索引里没有这个版本时，应用会挑一条**适配当前游戏版本**的最新条目
  // （也就是 2.7.24）来求值安装计划，于是 installed_packs.version 会被记成 2.7.24 ——
  // 而用户手上其实是 2.7.32。装出来的文件仍然是对的（安装映射是系列级的、只写变化的文件），
  // 但"记录版本"和之后的体检版本对账就不准了。
  //
  // 文件清单（artifacts）留空：没有官方包在手的人不该替有包的人编文件名与哈希。
  // 手上有 2.7.32 的完整包时请补上：
  //   { "id": "part1", "url": "local:<文件名>", "sha256": "<64 位十六进制，不知道可留 null>" }
  // 文件名与登记不符只会给一条软提示（整合版改名是常态）；填了 sha256 才会硬校验。
  //
  // 若你的游戏版本不是 2.6，把上面 game_version 改成实际值。
  // ---------------------------------------------------------------------------
  "artifacts": [],

  "mirrors": []
}
