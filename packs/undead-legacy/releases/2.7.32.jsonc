{
  "schema_version": 1,
  "pack": "undead-legacy",
  "version": "2.7.32",
  "game_version": { "min": "2.6", "max": "2.6" },

  // ---------------------------------------------------------------------------
  // 官方发布形态：作者在 GitHub 仓库里给的是**源码包**，用 GitHub 的「Download ZIP」下载时
  // 会自动多套一层 `<仓库名>-<分支名>/`（所以文件名带 `-main`）。两卷都要 `strip_components: 1`
  // 才能还原成配方期望的结构：BepInEx/、doorstop_libs/、doorstop_config.ini、winhttp.dll、
  // Mods/UndeadLegacy。
  //
  // 两卷必须一起用：Part1 是注入层与代码（含 Mods/UndeadLegacy/ModInfo.xml 与几个 dll），
  // Part2 只有 Mods/UndeadLegacy/Resources。剥掉外壳后两卷按选择顺序解压到**同一个 staging 根**，
  // Mods/UndeadLegacy 自然合并成完整的一份。
  //
  // 注意：当前实现里 strip_components 是**整批共用一个值**（取第一条 artifact 的），
  // 所以两卷必须写相同的层数。
  // ---------------------------------------------------------------------------
  "artifacts": [
    {
      "id": "part1",
      "url": "local:UndeadLegacyExperimentalPart1-main.zip",
      "sha256": null,
      "extract": "root",
      "strip_components": 1
    },
    {
      "id": "part2",
      "url": "local:UndeadLegacyExperimentalPart2-main.zip",
      "sha256": null,
      "extract": "root",
      "strip_components": 1
    }
  ],

  "mirrors": [],

  // ---------------------------------------------------------------------------
  // 待核实（欢迎拿到官方包的人来订正）：
  //
  // 1. **版本号**：这条对应作者 GitHub 上的 Experimental 仓库，下的是**分支**（`-main`）而不是
  //    固定版本；包内 `Mods/UndeadLegacy/ModInfo.xml` 写的是 `2.7.01`（作者常年不更新它），
  //    所以"这就等于 2.7.32"需要人来确认。
  // 2. **不要写 sha256**：GitHub 的 Download ZIP 是动态生成的，而且下的是分支——内容会随作者
  //    推进分支而变化。哈希在这里只会制造"昨天能装、今天说文件不符"。作者若在 Releases 里发布
  //    固定附件，那才是可以写哈希、可以长期引用的东西。
  // 3. **game_version**：按官方说明 UL 2.7.x 对应 7DTD 2.6；若实际不是，改这一行。
  // ---------------------------------------------------------------------------
}
