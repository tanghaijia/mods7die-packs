{
  "schema_version": 1,
  "pack": "undead-legacy",
  "version": "2.7.32",
  "game_version": { "min": "2.6", "max": "2.6" },

  // ---------------------------------------------------------------------------
  // 这是**增量补丁**条目：只包含 2.7.27 → 2.7.32 之间变化的文件。
  //
  // 实测这个压缩包（1.61 MB，87 个条目）里：
  //   - 全部文件都在 `Mods/UndeadLegacy/` 下（86 个文件 + 1 个目录条目）；
  //   - **没有** BepInEx/、doorstop_libs/、doorstop_config.ini、winhttp.dll；
  //   - **没有** Mods/UndeadLegacyChinese/（汉化不受影响）；
  //   - 没有外套目录，所以 strip_components: 0。
  //
  // 因此它必须声明成 `patch`：否则会被当成完整包，而升级清理会把补丁没碰到的
  // 三千多个文件判成"新版本已移除"→ 一次大规模误删。工具现在也会主动拦这种用法。
  //
  // `from` 只是**基线的声明**：已装版本与它不符时不拒绝，只要求用户确认（我们记录的版本
  // 来自运行日志/ModInfo，本身可能不准）。
  // ---------------------------------------------------------------------------
  "patch": { "from": ["2.7.27", "2.7.28", "2.7.29", "2.7.30", "2.7.31"] },

  "artifacts": [
    {
      "id": "delta",
      "url": "local:UndeadLegacy_2.7.27-2.7.32_Patch.zip",
      // 补丁只有 1.61 MB，写死哈希几乎不花时间，却能拦住"下载坏了"。
      // 需要时先算出这个文件的 sha256 再填进来（命令：
      //   Get-FileHash <文件> -Algorithm SHA256）。本机这份尚未计算，故留 null。
      "sha256": null,
      "extract": "root",
      "strip_components": 0
    }
  ],

  "mirrors": [],

  // ---------------------------------------------------------------------------
  // 使用前提（重要）：**补丁只能打在 2.7.27 上**。
  //
  // - 本机当前的副本是这套 CN 整合版的 **2.7.17**（见 releases/2.7.17.jsonc）；
  //   2.7.17 上没有 2.7.27 的基线，直接打这个补丁会得到"2.7.17 的文件 + 27→32 的差量"的
  //   混合状态（工具会警告并要求确认，但不推荐）。
  // - 想要 2.7.32，两条正路：
  //     ① 拿到 **CN 渠道的 2.7.27 完整包** → 升级到 2.7.27 → 再用这个补丁升到 2.7.32；
  //     ② 用**官方渠道的完整包**（`undead-legacy` 那条的 2.7.32，两卷 + strip_components: 1）——
  //        注意官方条目的组件里没有汉化目录，所以升级会把 `Mods/UndeadLegacyChinese` 删掉
  //        （计划预览里会看到这几条删除，可以先确认再决定）。
  // ---------------------------------------------------------------------------
}
