{
  "schema_version": 1,
  "pack": "undead-legacy",
  "version": "2.7.24",
  "game_version": { "min": "2.6", "max": "2.6" },

  // ---------------------------------------------------------------------------
  // 待核实（欢迎第一个 PR 来改）：
  // 这个版本号来自社区文档，**未经核对**。本机实测同一份安装里：
  //   Mods/UndeadLegacy/ModInfo.xml  写的是 2.7.01
  //   BepInEx/LogOutput.log 运行时写的是 2.7.17
  // 二者常年不一致（作者发补丁时不更新 ModInfo），所以 tag 该写多少、文件叫什么名字，
  // 需要手上真有官方下载包的人来定。工具对版本号的立场是"只用于提示与排序"，
  // 装不装得上由结构识别决定，所以这个数字不准不会导致装错——但它仍然该被修正。
  // 见仓库 README 的「待核实」一节。
  // ---------------------------------------------------------------------------

  // 多卷包：两个 part 按顺序解压到同一个 staging 根。
  // `local:` 前缀表示"由用户自行下载后提供，只按哈希校验"。
  // 如果作者提供了稳定直链，改成 "url": "https://…/UL-2.7.24-part1.zip"，并把 sha256 填上——
  // 填了哈希，应用在解压前就会硬校验，对不上直接拒绝。
  "artifacts": [
    {
      "id": "part1",
      "url": "local:UL-2.7.24-part1.zip",
      "sha256": null,
      "extract": "root",
      "strip_components": 0
    },
    {
      "id": "part2",
      "url": "local:UL-2.7.24-part2.zip",
      "sha256": null,
      "extract": "root",
      "strip_components": 0
    }
  ],

  // 网盘镜像：只展示，不代下。国内流传的整合版大多在这里。
  "mirrors": []
}
